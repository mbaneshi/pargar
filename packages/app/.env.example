# All VITE_* values are inlined into the static bundle at build time and are
# therefore public. Never put a service-role key or any other secret here.
#
# Local dev:  copy to packages/app/.env.local
# Server deploy: copy to packages/app/.env on the build host (untracked).
#             Vite's root is packages/app, so a repo-root .env is NOT read.
#             The Docker build bakes this file in; changing it needs a rebuild.

# Supabase (any self-hosted or hosted instance; the reference deployment
# uses the URL below). Both are required for sign-in and cloud save; with either one
# empty the app still builds and runs in guest-only mode.
VITE_SUPABASE_URL=https://supabase.houshkar.ir
VITE_SUPABASE_ANON_KEY=

# Sentry (optional — disabled when empty)
VITE_SENTRY_DSN=

# Ollama chat endpoint for the AI panel (optional — defaults to
# http://localhost:11434/api/chat and model gemma4 on the user's own machine)
VITE_OLLAMA_URL=
VITE_OLLAMA_MODEL=

# Logging
VITE_LOG_LEVEL=info
VITE_LOG_FORMAT=pretty
VITE_LOG_TARGETS=console
VITE_LOG_FILTER=*
VITE_LOG_BUFFER=false
