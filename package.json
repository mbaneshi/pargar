{
  "name": "nexus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "prepare": "git config core.hooksPath scripts/git-hooks",
    "build": "turbo build",
    "dev": "turbo dev --filter=@nexus/app",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:coverage": "turbo test -- --coverage",
    "pretest:e2e": "./scripts/cleanup-test-ports.sh",
    "test:e2e": "playwright test",
    "build:kernel": "cd packages/kernel && wasm-pack build --target web --out-dir pkg",
    "lint": "eslint packages/*/src/**/*.{ts,svelte}",
    "lint:fix": "eslint --fix packages/*/src/**/*.{ts,svelte}",
    "format": "prettier --write 'packages/*/src/**/*.{ts,svelte,json,css}'",
    "format:check": "prettier --check 'packages/*/src/**/*.{ts,svelte,json,css}'",
    "ci": "./scripts/local-ci.sh",
    "ci:fast": "./scripts/local-ci.sh fast",
    "ci:rust": "./scripts/local-ci.sh rust",
    "ci:quality": "./scripts/local-ci.sh quality",
    "parity:test": "vitest run --config scripts/vitest.config.ts",
    "parity:scrape": "tsx scripts/scrape-autocad-parity.ts",
    "validate:dxf": "node scripts/validate-dxf.mjs",
    "build:test-fixtures": "node scripts/build-test-fixtures.mjs",
    "gate": "node scripts/deploy-gate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.22.4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.1",
    "sirv-cli": "^3.0.1",
    "svelte-eslint-parser": "^1.8.0",
    "turbo": "^2.9.9",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  }
}
